#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

ensure_env() {
    if [[ ! -f .env ]]; then
        umask 077
        cp .env.example .env
        sed -i "s|^APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32 | tr -d '\n')|" .env
        sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=$(openssl rand -hex 32)|" .env
        sed -i "s|^MYSQL_ROOT_PASSWORD=.*|MYSQL_ROOT_PASSWORD=$(openssl rand -hex 32)|" .env
        sed -i "s|^DEV_UID=.*|DEV_UID=$(id -u)|" .env
        sed -i "s|^DEV_GID=.*|DEV_GID=$(id -g)|" .env
        chmod 600 .env
    fi
}

compose() {
    docker compose --project-name kutmb-hr "$@"
}

install_frontend() {
    if [[ -f package-lock.json ]]; then
        compose run --rm frontend npm ci
    else
        compose run --rm frontend npm install
    fi
}

tooling() {
    ensure_env
    compose build app frontend
    compose run --rm --user root app sh -lc 'chown -R "$DEV_UID:$DEV_GID" /var/www/html/vendor'
    compose run --rm --user root frontend sh -lc 'chown -R "$DEV_UID:$DEV_GID" /var/www/html/node_modules'
    compose run --rm app composer install --no-interaction
    install_frontend
}

setup() {
    tooling
    compose up -d --wait db
    compose run --rm app php artisan migrate --force
}

case "${1:-help}" in
    setup)
        setup
        ;;
    up)
        setup
        compose up -d app frontend
        vite_port="$(sed -n 's/^VITE_PORT=//p' .env | tail -n 1)"
        printf 'App: http://127.0.0.1:8000\nVite: http://127.0.0.1:%s\n' "${vite_port:-5173}"
        ;;
    down)
        compose down
        ;;
    test)
        setup
        compose run --rm frontend npm run build
        compose run --rm app php artisan test
        ;;
    mysql-test)
        tooling
        compose run --rm frontend npm run build
        test_network="kutmb-hr_default"
        test_container="kutmb-hr-wp030-mysql-test-$$"
        docker network inspect "$test_network" >/dev/null 2>&1 || docker network create "$test_network" >/dev/null
        docker run --detach --rm --name "$test_container" --network "$test_network" \
            --network-alias wp030-mysql-test \
            --env MYSQL_ROOT_PASSWORD=wp030-test-root \
            --env MYSQL_DATABASE=kutmb_hr_test \
            mysql:8.4.13@sha256:a0225d1ea6631c8bc2385dc4c2faba17bbf1834ecf369e1659a9a382bd8d5dd7 >/dev/null
        cleanup_mysql_test() {
            docker rm --force "$test_container" >/dev/null 2>&1 || true
        }
        trap cleanup_mysql_test EXIT
        for attempt in $(seq 1 60); do
            if docker exec "$test_container" mysqladmin ping -h 127.0.0.1 -uroot -pwp030-test-root --silent >/dev/null 2>&1; then
                break
            fi
            sleep 2
        done
        docker exec "$test_container" mysqladmin ping -h 127.0.0.1 -uroot -pwp030-test-root --silent
        compose run --rm --no-deps \
            -e APP_ENV=testing \
            -e DB_CONNECTION=mysql \
            -e DB_HOST=wp030-mysql-test \
            -e DB_PORT=3306 \
            -e DB_DATABASE=kutmb_hr_test \
            -e DB_USERNAME=root \
            -e DB_PASSWORD=wp030-test-root \
            -e DB_URL= \
            app sh -lc 'php artisan migrate:fresh --force && php artisan migrate:status && php bin/verify-database.php && php artisan test'
        ;;
    build)
        tooling
        compose run --rm frontend npm run build
        ;;
    types)
        tooling
        compose run --rm frontend npm run types:check
        ;;
    routes)
        tooling
        compose run --rm app php artisan route:list --except-vendor
        ;;
    migrate)
        tooling
        compose up -d --wait db
        compose run --rm app php artisan migrate --force
        ;;
    audit)
        tooling
        compose run --rm app composer audit
        compose run --rm frontend npm audit
        ;;
    check)
        setup
        compose run --rm frontend npm run build
        compose run --rm frontend composer ci:check
        compose run --rm app composer audit
        compose run --rm frontend npm audit
        ;;
    *)
        printf 'Usage: %s {setup|up|down|test|mysql-test|check|build|types|routes|migrate|audit}\n' "$0"
        exit 2
        ;;
esac
